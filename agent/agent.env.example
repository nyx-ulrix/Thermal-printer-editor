# /etc/kanban-print-agent.env  (root-only, mode 600: it holds the agent token)
# After editing: sudo systemctl restart kanban-print-agent

# URL of the kanban board. Must be https:// (plain http is only accepted for localhost).
SERVER_URL=
# Agent token from the board's settings. Never logged.
AGENT_TOKEN=

# Where to send labels:
#   /dev/usb/lp0          USB printer via the usblp kernel module (default)
#   tcp://HOST:9100       network printer, raw port
#   cups:QUEUE_NAME       existing raw CUPS queue (sent with: lp -d QUEUE_NAME -o raw)
PRINTER=/dev/usb/lp0

# Label stock, in millimetres. LABEL_GAP_MM=0 means continuous media (no gap sensing).
LABEL_WIDTH_MM=40
LABEL_HEIGHT_MM=30
LABEL_GAP_MM=2

# Print darkness 0-15, speed in inches/s, DIRECTION 0 or 1 (flips the print 180 degrees).
DENSITY=8
SPEED=4
DIRECTION=1

# Calibration: shift everything right/down by this many dots (8 dots = 1 mm, may be negative).
OFFSET_X_DOTS=0
OFFSET_Y_DOTS=0

# Seconds between polls of the board.
POLL_SECONDS=3
